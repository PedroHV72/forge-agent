#!/usr/bin/env bash
# forge-creds — CLI wrapper over scripts/forge-creds.js
#
# Translates subcommands into flags, like bin/forge-accounts:
#
#   forge-creds add railway producao          → --add railway producao  (stdin)
#   forge-creds list [--json]                 → --list
#   forge-creds exec railway producao -- ...  → --exec railway producao -- ...
#   forge-creds remove railway producao       → --remove railway producao
#   forge-creds services                      → --services
#
# The secret is read from stdin, never from an argument:
#   printf %s "$TOKEN" | forge-creds add railway producao
set -euo pipefail

ENGINE="$HOME/.claude/scripts/forge-creds.js"
if [ ! -f "$ENGINE" ]; then
  # Current prefs format (JSONC): skip commented lines, take the last live
  # assignment, strip quotes and commas.
  PREFS="$HOME/.claude/forge-agent-prefs.jsonc"
  [ -f "$PREFS" ] || PREFS="$HOME/.claude/forge-agent-prefs.json"
  if [ -f "$PREFS" ]; then
    REPO="$(sed 's/[[:space:]]*\/\/.*$//' "$PREFS" 2>/dev/null \
      | grep -E '^[[:space:]]*"repo_path"[[:space:]]*:' \
      | tail -1 | cut -d: -f2- | tr -d ' ",' || true)"
    [ -n "${REPO:-}" ] && [ -f "$REPO/scripts/forge-creds.js" ] && ENGINE="$REPO/scripts/forge-creds.js"
  fi
fi
if [ ! -f "$ENGINE" ]; then
  echo "forge-creds: engine não encontrado. Rode ./install.sh" >&2
  exit 1
fi

[ $# -eq 0 ] && exec node "$ENGINE" --help

sub="$1"
case "$sub" in
  add|remove)
    shift
    if [ $# -lt 2 ]; then
      echo "forge-creds: '$sub' requer <serviço> <nome>" >&2
      exit 2
    fi
    svc="$1"; name="$2"; shift 2
    exec node "$ENGINE" "--$sub" "$svc" "$name" "$@"
    ;;
  exec)
    shift
    if [ $# -lt 3 ]; then
      echo "forge-creds: 'exec' requer <serviço> <nome> -- <comando>" >&2
      exit 2
    fi
    svc="$1"; name="$2"; shift 2
    exec node "$ENGINE" --exec "$svc" "$name" "$@"
    ;;
  list|services)
    shift
    exec node "$ENGINE" "--$sub" "$@"
    ;;
  -h|--help|help)
    exec node "$ENGINE" --help
    ;;
  --*)
    exec node "$ENGINE" "$@"
    ;;
  *)
    echo "forge-creds: subcomando desconhecido: $sub" >&2
    echo "  use: add | list | exec | remove | services" >&2
    exit 2
    ;;
esac
